<?xml version="1.0" encoding="utf-8"?>
<!--
  Letakkan file ini di: res/navigation/nav_graph.xml
  Buat folder 'navigation' di dalam res jika belum ada.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/welcomeFragment">

    <!-- ✅ BARU: Welcome / Role Selection -->
    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.kabaddikounter.WelcomeFragment"
        android:label="Welcome Fragment"
        tools:layout="@layout/fragment_welcome">

        <!-- ADMIN → HomeFragment, welcome di-pop dari back stack -->
        <action
            android:id="@+id/action_welcomeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />

        <!-- VIEWER → MatchListFragment, welcome di-pop dari back stack -->
        <action
            android:id="@+id/action_welcomeFragment_to_matchListFragment"
            app:destination="@id/matchListFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Fragment yang sudah ada — TIDAK diubah, hanya tambahkan action Keluar -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.kabaddikounter.HomeFragment"
        android:label="Pertandingan"
        tools:layout="@layout/fragment_home">

        <!-- ✅ BARU: action Keluar → kembali ke welcomeFragment -->
        <!-- Tambahkan action ini, sisanya sesuaikan dengan yang sudah ada -->
        <action
            android:id="@+id/action_homeFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/matchListFragment"
        android:name="com.example.kabaddikounter.MatchListFragment"
        android:label="Pertandingan"
        tools:layout="@layout/fragment_match_list">

        <!-- ✅ BARU: action Keluar → kembali ke welcomeFragment -->
        <action
            android:id="@+id/action_matchListFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/matchListFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/actionMatchListToDetailMatch"
            app:destination="@id/detailMatchFragment" />
    </fragment>

    <!-- Destinasi 2: RiwayatFragment -->
    <fragment
        android:id="@+id/riwayatFragment"
        android:name="com.example.kabaddikounter.RiwayatFragment"
        android:label="Riwayat Match"
        tools:layout="@layout/fragment_riwayat" />

    <!-- Destinasi 3: SettingsFragment -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.kabaddikounter.SettingsFragment"
        android:label="Pengaturan"
        tools:layout="@layout/fragment_settings" />

    <fragment android:id="@+id/detailMatchFragment"
        android:name="com.example.kabaddikounter.DetailMatchFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail_match" >
        <argument
            android:name="matchId"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

</navigation>

