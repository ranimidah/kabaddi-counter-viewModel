<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="match"
            type="com.example.kabaddikounter.data.MatchEntity" />
        <variable
            name="isExpanded"
            type="boolean" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header (selalu tampil, bisa diklik) -->
            <LinearLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{match.title}"
                        android:textColor="#2222CC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Tim A vs Tim B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@{`Pemenang: ` + match.winner}"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        tools:text="Pemenang: TIM A" />

                </LinearLayout>

                <!-- Chevron icon: panah bawah saat collapsed, panah atas saat expanded -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@{isExpanded ? @drawable/ic_chevron_up : @drawable/ic_chevron_down}"
                    android:contentDescription="@null"
                    tools:src="@drawable/ic_chevron_down" />

            </LinearLayout>

            <!-- Detail section (tampil hanya saat expanded) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="14dp"
                android:background="#E8E8F8"
                android:visibility="@{isExpanded ? android.view.View.VISIBLE : android.view.View.GONE}">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Skor total"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{match.teamAName + ` : ` + match.scoreA}"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="TIM A : 2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{match.teamBName + ` : ` + match.scoreB}"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    tools:text="TIM B : 0" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</layout>