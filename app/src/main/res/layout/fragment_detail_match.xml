<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.example.kabaddikounter.viewModels.DetailMatchViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/white">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- LIVE MATCH Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="LIVE MATCH"
                    android:textColor="@color/red_live"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:letterSpacing="0.05" />

                <!-- Match Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:text="@{viewModel.matchInfo}"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="Pertandingan pukul 10:23 WIB Tim A melawan Tim B" />

                <!-- Score Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">

                    <!-- Tim A Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{viewModel.match.teamA}"
                                android:textColor="@color/blue_primary"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                tools:text="Tim A" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@{String.valueOf(viewModel.match.scoreA)}"
                                android:textColor="@android:color/black"
                                android:textStyle="bold"
                                android:textSize="36sp"
                                tools:text="0" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- VS Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="vs"
                        android:textColor="@color/blue_primary"
                        android:textStyle="bold"
                        android:textSize="18sp" />

                    <!-- Tim B Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="110dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{viewModel.match.teamB}"
                                android:textColor="@color/blue_primary"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                tools:text="Tim B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@{String.valueOf(viewModel.match.scoreB)}"
                                android:textColor="@android:color/black"
                                android:textStyle="bold"
                                android:textSize="36sp"
                                tools:text="1" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Last Update Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Update"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <!-- Update List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLastUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_last_update" />

                </LinearLayout>

                <!-- Subscribe Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subscribe untuk Live Pertandingan"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{viewModel.subscribeStatusText}"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="Notifikasi belum diaktifkan!" />

                    <Button
                        android:id="@+id/btnSubscribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@{viewModel.subscribeButtonText}"
                        app:backgroundTintColor="@{viewModel.subscribeButtonColor}"
                        android:onClick="@{() -> viewModel.toggleSubscribe()}"
                        android:textColor="@android:color/white"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textSize="14sp"
                        app:cornerRadius="6dp"
                        tools:text="Subscribe"
                        tools:backgroundTint="@color/blue_primary" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</layout>