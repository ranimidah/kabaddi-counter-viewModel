<!-- res/layout/item_match.xml -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="match"
            type="com.example.kabaddikounter.data.MatchEntity" />
        <variable
            name="isExpanded"
            type="Boolean" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{match.team_a + ` vs ` + match.team_b}" />

            <TextView
                android:id="@+id/textWinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{`Pemenang: ` + match.winner}" />

            <ImageView
                android:id="@+id/iconChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="@{isExpanded ? 180f : 0f}"
                app:srcCompat="@drawable/ic_chevron_down" />

        </LinearLayout>

        <!-- Detail -->
        <LinearLayout
            android:id="@+id/layoutDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="@{isExpanded ? android.view.View.VISIBLE : android.view.View.GONE}">

            <TextView
                android:id="@+id/textScoreA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{match.team_a + ` : ` + match.score_a}" />

            <TextView
                android:id="@+id/textScoreB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{match.team_b + ` : ` + match.score_b}" />

        </LinearLayout>

    </LinearLayout>
</layout>