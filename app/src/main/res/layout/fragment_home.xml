<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="com.example.kabaddikounter.viewModels.ScoreViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/bgColor">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Subscription Status Banner (visible when subscribed) -->
            <LinearLayout
                android:id="@+id/subscribeStatusBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1565C0"
                android:padding="10dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvSubscribeStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Berlangganan: Team A vs Team B" />

            </LinearLayout>

            <!-- CARD TIM A -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTeamA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="?attr/cardWhiteBackground"
                app:layout_constraintTop_toBottomOf="@+id/subscribeStatusBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cardTeamB"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintBottom_toTopOf="@+id/buttonTeamA1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/teamAName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@={viewModel.teamA}"
                        android:hint="Team Name"
                        android:textSize="18sp"
                        android:textColorHint="?attr/textModeColor"
                        android:enabled="@{viewModel.isSubscribed != true}" />

                    <TextView
                        android:id="@+id/scoreA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:textColor="?attr/labelTextColor"
                        android:text="@{viewModel.scoreA.toString()}" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD TIM B -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTeamB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:textColorHint="?attr/textModeColor"
                app:cardBackgroundColor="?attr/cardWhiteBackground"
                app:layout_constraintTop_toBottomOf="@+id/subscribeStatusBar"
                app:layout_constraintStart_toEndOf="@+id/cardTeamA"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/buttonTeamB1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <EditText
                        android:id="@+id/teamBName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@={viewModel.teamB}"
                        android:hint="Team Name"
                        android:textSize="18sp"
                        android:textColorHint="?attr/textModeColor"
                        android:enabled="@{viewModel.isSubscribed != true}" />

                    <TextView
                        android:id="@+id/scoreB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="64sp"
                        android:textStyle="bold"
                        android:textColor="?attr/labelTextColor"
                        android:text="@{viewModel.scoreB.toString()}" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol +1 dan +2 Tim A -->
            <Button
                android:id="@+id/buttonTeamA1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="4dp"
                android:text="+1"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@android:color/white"
                android:onClick="@{() -> viewModel.incrementScoreA(1)}"
                android:enabled="@{viewModel.isSubscribed != true}"
                app:layout_constraintTop_toBottomOf="@+id/cardTeamA"
                app:layout_constraintStart_toStartOf="@+id/cardTeamA"
                app:layout_constraintEnd_toStartOf="@+id/buttonTeamA2" />

            <Button
                android:id="@+id/buttonTeamA2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:text="+2"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@android:color/white"
                android:onClick="@{() -> viewModel.incrementScoreA(2)}"
                android:enabled="@{viewModel.isSubscribed != true}"
                app:layout_constraintTop_toBottomOf="@+id/cardTeamA"
                app:layout_constraintStart_toEndOf="@+id/buttonTeamA1"
                app:layout_constraintEnd_toEndOf="@+id/cardTeamA" />

            <!-- Tombol +1 dan +2 Tim B -->
            <Button
                android:id="@+id/buttonTeamB1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="4dp"
                android:text="+1"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@android:color/white"
                android:onClick="@{() -> viewModel.incrementScoreB(1)}"
                android:enabled="@{viewModel.isSubscribed != true}"
                app:layout_constraintTop_toBottomOf="@+id/cardTeamB"
                app:layout_constraintStart_toStartOf="@+id/cardTeamB"
                app:layout_constraintEnd_toStartOf="@+id/buttonTeamB2" />

            <Button
                android:id="@+id/buttonTeamB2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:text="+2"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@android:color/white"
                android:onClick="@{() -> viewModel.incrementScoreB(2)}"
                android:enabled="@{viewModel.isSubscribed != true}"
                app:layout_constraintTop_toBottomOf="@+id/cardTeamB"
                app:layout_constraintStart_toEndOf="@+id/buttonTeamB1"
                app:layout_constraintEnd_toEndOf="@+id/cardTeamB" />

            <!-- Tombol RESET (handled in Fragment, not DataBinding) -->
            <Button
                android:id="@+id/buttonReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="RESET"
                android:backgroundTint="#F4900C"
                android:textColor="@android:color/white"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                app:layout_constraintTop_toBottomOf="@+id/buttonTeamA2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tombol Simpan Match -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSimpan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:text="Simpan Match"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_save"
                app:iconTint="@android:color/white"
                app:iconPadding="8dp"
                app:layout_constraintTop_toBottomOf="@+id/buttonReset"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/buttonExport" />

            <!-- Tombol Export JSON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:text="Export JSON"
                android:backgroundTint="@color/blue_primary"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_json"
                app:iconTint="@android:color/white"
                app:iconPadding="8dp"
                app:layout_constraintTop_toBottomOf="@+id/buttonReset"
                app:layout_constraintStart_toEndOf="@+id/buttonSimpan"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Status LIVE -->
            <TextView
                android:id="@+id/tvLiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE"
                android:textColor="#E53935"
                android:textSize="13sp"
                android:layout_marginTop="12dp"
                android:visibility="@{viewModel.currentMatch != null &amp;&amp; viewModel.currentMatch.status.equals(`LIVE`) ? View.VISIBLE : View.GONE}"
                app:layout_constraintTop_toBottomOf="@+id/buttonSimpan"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tombol End Live -->
            <Button
                android:id="@+id/buttonEndLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Live"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E53935"
                android:textColor="@android:color/white"
                android:visibility="@{viewModel.currentMatch != null &amp;&amp; viewModel.currentMatch.status.equals(`LIVE`) ? View.VISIBLE : View.GONE}"
                app:layout_constraintTop_toBottomOf="@+id/tvLiveStatus"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tonton Live Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenMatchList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="Tonton Live"
                android:backgroundTint="#1565C0"
                android:textColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@+id/buttonEndLive"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</layout>
