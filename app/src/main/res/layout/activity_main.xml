<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.example.kabaddikounter.viewModels.ScoreViewModel" />
    </data>

    <!-- penambahan drawer component -->
    <!-- Root: DrawerLayout -->
    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <!-- Konten utama -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- AppBar + Toolbar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/bgToolbar"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:title="Kabaddi Kounter"
                app:titleTextColor="@android:color/white" />

        </com.google.android.material.appbar.AppBarLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:context=".MainActivity"
                android:padding="16dp"
                android:background="?attr/bgColor"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <!-- Dark Mode Toggle -->
                <TextView
                    android:id="@+id/textDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dark Mode"
                    android:textSize="14sp"
                    android:textColor="?attr/textModeColor"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/switchTheme"
                    app:layout_constraintBaseline_toBaselineOf="@+id/switchTheme"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    android:checked="@{viewModel.isDarkMode}"
                    android:onCheckedChanged="@{(button, isChecked) -> viewModel.toggleTheme(isChecked)}"
                    android:thumb="@drawable/ic_moon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- CARD TIM A -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTeamA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="?attr/cardWhiteBackground"
                    app:layout_constraintTop_toBottomOf="@+id/switchTheme"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/cardTeamB"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintBottom_toTopOf="@+id/buttonTeamA1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <EditText
                            android:id="@+id/teamAName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@={viewModel.teamA}"
                            android:hint ="Team Name"
                            android:textSize="18sp"
                            android:textColorHint="?attr/textModeColor"
                            app:layout_constraintBottom_toTopOf="@+id/scoreA"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/teamBName"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/scoreA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="64sp"
                            android:textStyle="bold"
                            android:textColor="?attr/labelTextColor"
                            android:text="@{viewModel.scoreA.toString()}" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CARD TIM B -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTeamB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:textColorHint="?attr/textModeColor"
                    app:cardBackgroundColor="?attr/cardWhiteBackground"
                    app:layout_constraintTop_toBottomOf="@+id/switchTheme"
                    app:layout_constraintStart_toEndOf="@+id/cardTeamA"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/buttonTeamB1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <EditText
                            android:id="@+id/teamBName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@={viewModel.teamB}"
                            android:hint ="Team Name"
                            android:textSize="18sp"
                            app:layout_constraintBottom_toTopOf="@+id/scoreA"
                            app:layout_constraintEnd_toStartOf="@+id/teamBName"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintHorizontal_chainStyle="spread"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/scoreB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="64sp"
                            android:textStyle="bold"
                            android:textColor="?attr/labelTextColor"
                            android:text="@{viewModel.scoreB.toString()}" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Tombol +1 dan +2 Tim A -->
                <Button
                    android:id="@+id/buttonTeamA1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    android:text="+1"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    android:onClick="@{() -> viewModel.incrementScoreA(1)}"
                    app:layout_constraintTop_toBottomOf="@+id/cardTeamA"
                    app:layout_constraintStart_toStartOf="@+id/cardTeamA"
                    app:layout_constraintEnd_toStartOf="@+id/buttonTeamA2" />

                <Button
                    android:id="@+id/buttonTeamA2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="4dp"
                    android:text="+2"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    android:onClick="@{() -> viewModel.incrementScoreA(2)}"
                    app:layout_constraintTop_toBottomOf="@+id/cardTeamA"
                    app:layout_constraintStart_toEndOf="@+id/buttonTeamA1"
                    app:layout_constraintEnd_toEndOf="@+id/cardTeamA" />

                <!-- Tombol +1 dan +2 Tim B -->
                <Button
                    android:id="@+id/buttonTeamB1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="4dp"
                    android:text="+1"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    android:onClick="@{() -> viewModel.incrementScoreB(1)}"
                    app:layout_constraintTop_toBottomOf="@+id/cardTeamB"
                    app:layout_constraintStart_toStartOf="@+id/cardTeamB"
                    app:layout_constraintEnd_toStartOf="@+id/buttonTeamB2" />

                <Button
                    android:id="@+id/buttonTeamB2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="4dp"
                    android:text="+2"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    android:onClick="@{() -> viewModel.incrementScoreB(2)}"
                    app:layout_constraintTop_toBottomOf="@+id/cardTeamB"
                    app:layout_constraintStart_toEndOf="@+id/buttonTeamB1"
                    app:layout_constraintEnd_toEndOf="@+id/cardTeamB" />

                <!-- Tombol RESET -->
                <Button
                    android:id="@+id/buttonReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="RESET"
                    android:backgroundTint="#F4900C"
                    android:textColor="@android:color/white"
                    android:paddingStart="40dp"
                    android:paddingEnd="40dp"
                    android:onClick="@{() -> viewModel.reset()}"
                    app:layout_constraintTop_toBottomOf="@+id/buttonTeamA2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Tombol Simpan Match -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSimpan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="8dp"
                    android:text="Simpan Match"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_save"
                    app:iconTint="@android:color/white"
                    app:iconPadding="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/buttonReset"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/buttonExport" />

                <!-- Tombol Export JSON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="8dp"
                    android:text="Export JSON"
                    android:backgroundTint="@color/blue_primary"
                    android:textColor="@android:color/white"
                    app:icon="@drawable/ic_json"
                    app:iconTint="@android:color/white"
                    app:iconPadding="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/buttonReset"
                    app:layout_constraintStart_toEndOf="@+id/buttonSimpan"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- Navigation Drawer -->
        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:menu="@menu/drawer_menu" />

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>